{
  "name": "memento",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint src web/src",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply memento-db --local",
    "db:migrate": "wrangler d1 migrations apply memento-db --remote",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
